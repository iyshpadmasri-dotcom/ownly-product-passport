# Server Configuration
PORT=5000

# Database Configuration
# Local SQLite development (zero configuration required):
DATABASE_URL="file:./dev.db"

# PostgreSQL Configuration (for Production or local Postgres):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ownly_db?schema=public"

# Security
JWT_SECRET="your-ultra-secure-jwt-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"

# Optional Cloudinary Configuration (if using cloud uploads)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
